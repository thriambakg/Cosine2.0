# AWS Cognito Configuration
# Replace these values with your actual Cognito configuration from Terraform outputs

# Cognito User Pool ID (from terraform output)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX

# Cognito User Pool Client ID (from terraform output)
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# Cognito Identity Pool ID (from terraform output) 
NEXT_PUBLIC_COGNITO_IDENTITY_POOL_ID=us-east-1:XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# AWS Region
NEXT_PUBLIC_AWS_REGION=us-east-1

# Cognito Domain for Hosted UI (from terraform output)
NEXT_PUBLIC_COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com

# Redirect URLs for OAuth (update with your actual domain in production)
NEXT_PUBLIC_REDIRECT_SIGN_IN=http://localhost:3000/
NEXT_PUBLIC_REDIRECT_SIGN_OUT=http://localhost:3000/

# Optional: API Base URL for backend integration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Optional: Environment
NODE_ENV=development
